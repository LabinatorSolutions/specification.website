---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { categories, changeTypeLabel, site } from "~/lib/site";
import { getCollection } from "astro:content";
import "~/styles/hallmark-home.css";
const topics = await getCollection("spec", ({ data }) => !data.draft);
const counts = Object.fromEntries(
  categories.map((c) => [
    c.slug,
    topics.filter((t) => t.data.category === c.slug).length,
  ]),
);
const changes = (await getCollection("changelog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
const dateFmt = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
const groups = [
  {
    name: "The document",
    caption: "Start with the essentials",
    slugs: ["foundations"],
  },
  {
    name: "The experience",
    caption: "Make it usable",
    slugs: ["accessibility", "performance", "i18n"],
  },
  {
    name: "The trust",
    caption: "Protect people and keep working",
    slugs: ["security", "privacy", "resilience"],
  },
  {
    name: "The discovery",
    caption: "Be found and understood",
    slugs: ["seo", "well-known", "agent-readiness"],
  },
];
const statusCopy = [
  {
    key: "required",
    title: "Required",
    symbol: "●",
    text: "The platform breaks, or people are harmed, without it.",
  },
  {
    key: "recommended",
    title: "Recommended",
    symbol: "◐",
    text: "Something a modern website should do.",
  },
  {
    key: "optional",
    title: "Optional",
    symbol: "○",
    text: "Useful when the context calls for it.",
  },
  {
    key: "avoid",
    title: "Avoid",
    symbol: "×",
    text: "Outdated, harmful, or superseded.",
  },
];
---

<BaseLayout title={site.name} description={site.description}>
  <div class="field-guide">
    <section class="field-hero" aria-labelledby="field-title">
      <div class="hero-copy">
        <h1 id="field-title">
          What a good
          <br />
          website <span>does.</span>
        </h1>
        <p>
          A field guide to the technical details that matter. From your first{" "}
          <code>&lt;title&gt;</code> to your last HTTP header. For humans and
          agents, whatever your stack.
        </p>
        <div class="hero-actions">
          <a class="action" href="/spec/">
            Explore the spec <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/checklist/">
            Get the checklist <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hero-facts">
          <span>
            <strong>{topics.length}</strong> topics
          </span>
          <span>
            <strong>{categories.length}</strong> areas
          </span>
          <a href={site.repo}>Built in the open ↗</a>
        </div>
      </div>
      <figure class="system-map" aria-labelledby="map-title">
        <figcaption id="map-title">
          <span>Anatomy of a good website</span>
          <span aria-hidden="true">↙</span>
        </figcaption>
        <div class="map-layers">
          {groups.map((group, i) => (
            <div class="map-layer">
              <>
                <div class="map-heading">
                  <>
                    <span class="map-number" aria-hidden="true">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <h2>{group.name}</h2>
                    <span class="map-caption">{group.caption}</span>
                  </>
                </div>
                <ul>
                  {group.slugs.map((slug) => {
                    const category = categories.find((c) => c.slug === slug)!;
                    return (
                      <li>
                        <a href={`/spec/${slug}/`}>
                          {category.title}
                          <span aria-hidden="true">↗</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </>
            </div>
          ))}
        </div>
        <p class="map-foot">One website. All of these responsibilities.</p>
      </figure>
    </section>
    <section class="updates-section" aria-labelledby="updates-title">
      <div>
        <h2 id="updates-title">
          The web moves.
          <br />
          <span>So does the spec.</span>
        </h2>
        <a class="text-link" href="/changelog/">
          Full changelog →
        </a>
      </div>
      <ol>
        {changes.map((entry) => (
          <li>
            <>
              <time datetime={entry.data.date}>
                {dateFmt.format(new Date(entry.data.date))}
              </time>
              <div>
                <>
                  <span>{changeTypeLabel[entry.data.type]}</span>
                  <h3>
                    <a href={`/changelog/#${entry.id}`}>{entry.data.title}</a>
                  </h3>
                </>
              </div>
            </>
          </li>
        ))}
      </ol>
    </section>
    <section class="topic-section" aria-labelledby="topics-title">
      <div class="section-heading">
        <h2 id="topics-title">
          Every detail.
          <br />
          <span>A reason behind it.</span>
        </h2>
        <p>
          Ten areas, grounded in web standards.
          <br />
          Pick the part of your site you’re working on.
        </p>
      </div>
      <ul class="topic-grid">
        {categories.map((category, i) => (
          <li>
            <a class="topic-link" href={`/spec/${category.slug}/`}>
              <>
                <span class="topic-number" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <>
                    <h3>{category.title}</h3>
                    <p>{category.summary}</p>
                  </>
                </div>
                <span class="topic-end">
                  <>
                    <span>{counts[category.slug]} topics</span>
                    <strong aria-hidden="true">↗</strong>
                  </>
                </span>
              </>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section class="working-section" aria-labelledby="working-title">
      <div class="working-intro">
        <h2 id="working-title">
          Read it.
          <br />
          Check it.
          <br />
          <span>Make it better.</span>
        </h2>
        <a class="text-link" href="/checklist/">
          Open the checklist →
        </a>
      </div>
      <div class="working-body">
        <p class="working-lede">
          Every topic explains what it is, why it matters, and how to implement
          it. Every item in the checklist is a yes/no.
        </p>
        <dl class="status-grid">
          {statusCopy.map((s) => (
            <div>
              <>
                <dt>
                  <span aria-hidden="true">{s.symbol}</span>
                  {s.title}
                  <strong>
                    {topics.filter((t) => t.data.status === s.key).length}
                  </strong>
                </dt>
                <dd>{s.text}</dd>
              </>
            </div>
          ))}
        </dl>
        <p class="working-note">
          Audit your site. Learn what’s missing. Fix it, then re-check.
        </p>
      </div>
    </section>
    <section class="agent-section" id="mcp" aria-labelledby="agent-title">
      <div>
        <h2 id="agent-title">
          Same spec.
          <br />
          <span>Another pair of eyes.</span>
        </h2>
        <p>
          Let your agent query the whole specification through an open,
          read-only MCP server. No authentication needed for the reference
          tools.
        </p>
        <div class="agent-actions">
          <a class="action" href="/mcp/">
            Connect MCP ↗
          </a>
          <a
            class="text-link"
            href="/.well-known/agent-skills/specification-website/SKILL.md"
          >
            Agent Skill →
          </a>
          <a class="text-link" href="/llms.txt">
            llms.txt →
          </a>
        </div>
      </div>
      <div
        class="agent-diagram"
        aria-label="Humans read HTML, agents read Markdown or use MCP; all use the same specification"
      >
        <div class="diagram-source">
          <span>{topics.length} topics</span>
          <strong>One specification</strong>
        </div>
        <div class="diagram-branches">
          <div>
            <span>For people</span>
            <a href="/spec/">HTML ↗</a>
          </div>
          <div>
            <span>For agents</span>
            <a href="/llms.txt">Markdown ↗</a>
            <a href="/mcp/">MCP ↗</a>
          </div>
        </div>
      </div>
    </section>
    <section class="principles" aria-label="Principles">
      <p>
        <strong>Standards, not opinions.</strong> Primary sources on every
        topic.
      </p>
      <p>
        <strong>Platform agnostic.</strong> The web is the common ground.
      </p>
      <p>
        <strong>Built in the open.</strong>
        <a href={site.repo}>Pull requests welcome ↗</a>
      </p>
    </section>
  </div>
</BaseLayout>
